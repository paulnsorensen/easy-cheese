# Easy-cheese runtime scratch (research notes, age sidecars, mold state, etc.)
.cheese/

# Conductor workspace scratch
.context/

# Serena MCP project state
.serena/

# Claude Code machine-local worktree registry
.claude/worktrees/

# Coding-agent scratch dirs; keep the repo-maintained authoring skills trackable.
# This is an allowlist: every tracked skill dir needs its own `!` line here, or
# it is silently untracked.
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/python-authoring/
!.agents/skills/skill-authoring/
.claude/skills/

# milknado optional-plugin runtime data (SQLite task graph)
.milknado/

# Python
__pycache__/
*.pyc
.venv/
.venv-typing/
node_modules/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Starlight build output and generated docs
dist/
.astro/
src/sidebar.mjs
src/content/docs/**
!src/content/docs/

# `just release-preview` staging output (hidden so validate_skills.py skips it)
.release-preview/

# `just vendor` output — extracted wheel trees rebuilt from requirements-vendor.txt
/vendor/
