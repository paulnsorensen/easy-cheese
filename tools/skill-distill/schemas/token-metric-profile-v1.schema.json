{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easy-cheese.dev/schemas/skill-distill/token-metric-profile-v1.schema.json",
  "title": "TokenMetricProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["tokenizer_identity_digest", "load_events", "schema_version"],
