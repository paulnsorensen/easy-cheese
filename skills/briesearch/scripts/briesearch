#!/usr/bin/env python3
"""Generated by wedge. Do not edit; run `wedge lock` to regenerate.

Downloads (or reuses a cached) content-addressed .pyz, verifies its content
sha256 (member names and uncompressed bytes) against the lock beside this
file, and execs it.
"""

import hashlib
import json
import os
import sys
import tempfile
import urllib.request
import zipfile
from pathlib import Path

MAX_UNCOMPRESSED = 512 * 1024 * 1024
RUNNABLE_METHODS = (zipfile.ZIP_STORED, zipfile.ZIP_DEFLATED)


def _fail(message: str) -> None:
    print(json.dumps({"error": message, "exit_code": 3}), file=sys.stderr)
    sys.exit(3)


def _content_sha256(path: Path):
    """Keep in step with wedge._digest.content_sha256; None if unreadable."""
    digest = hashlib.sha256(b"wedge-content-v1\0")
    total = 0
    try:
        with zipfile.ZipFile(path) as archive:
            for info in archive.infolist():
                if info.compress_type not in RUNNABLE_METHODS:
                    return None
                total += info.file_size
                if total > MAX_UNCOMPRESSED:
                    return None
                name = info.filename.encode("utf-8")
                digest.update(len(name).to_bytes(8, "big") + name)
                digest.update(info.file_size.to_bytes(8, "big"))
                with archive.open(info) as member:
                    for chunk in iter(lambda: member.read(1 << 20), b""):
                        digest.update(chunk)
    except Exception:  # any unreadable archive (bad zip, zlib, CRC) is a mismatch
        return None
    return digest.hexdigest()


def _exec(pyz: Path) -> None:
    os.execv(sys.executable, [sys.executable, str(pyz), *sys.argv[1:]])


def main() -> None:
    launcher = Path(__file__).resolve()
    lock_path = launcher.parent / f"{launcher.name}.wedge.json"
    try:
        lock = json.loads(lock_path.read_text())
    except OSError as exc:
        _fail(f"cannot read lock {lock_path}: {exc}")
        return

    content_sha256 = lock["content_sha256"]
    asset = lock["asset"]
    repo = lock["repo"]
    release = lock["release"]

    pyz_env = os.environ.get("WEDGE_PYZ")
    if pyz_env:
        pyz = Path(pyz_env)
        if not pyz.is_file():
            _fail(f"WEDGE_PYZ {pyz} does not exist")
            return
        if _content_sha256(pyz) != content_sha256:
            _fail(f"WEDGE_PYZ {pyz} content sha256 does not match the lock")
            return
        _exec(pyz)
        return

    cache_root = Path(
        os.environ.get("WEDGE_CACHE")
        or os.path.join(
            os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "wedge"
        )
    )
    cache_root.mkdir(parents=True, exist_ok=True)
    cached = cache_root / asset
    if cached.is_file() and _content_sha256(cached) == content_sha256:
        _exec(cached)
        return

    base = os.environ.get("WEDGE_BASE_URL", "https://github.com")
    host = base.split("://", 1)[-1].split("/", 1)[0].split(":", 1)[0]
    if not base.startswith("https://") and host not in ("127.0.0.1", "localhost"):
        _fail(f"WEDGE_BASE_URL {base!r} must be https:// unless the host is localhost")
        return
    url = f"{base}/{repo}/releases/download/{release}/{asset}"

    tmp_name = None
    try:
        with urllib.request.urlopen(url, timeout=30) as response:
            fd, tmp_name = tempfile.mkstemp(dir=cache_root, prefix=".download-")
            with os.fdopen(fd, "wb") as handle:
                while True:
                    chunk = response.read(1 << 20)
                    if not chunk:
                        break
                    handle.write(chunk)
    except OSError as exc:
        if tmp_name:
            Path(tmp_name).unlink(missing_ok=True)
        _fail(f"download {url} failed: {exc}")
        return

    tmp_path = Path(tmp_name)
    if _content_sha256(tmp_path) != content_sha256:
        tmp_path.unlink(missing_ok=True)
        _fail(f"downloaded {url} content sha256 does not match the lock")
        return
    os.replace(tmp_path, cached)
    _exec(cached)


if __name__ == "__main__":
    main()
